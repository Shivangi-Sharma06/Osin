# Copy to .env and adjust. All values have sane local defaults in server/src/config.ts.
PORT=4000
DATABASE_URL=postgres://osin@127.0.0.1:5433/osin
REDIS_URL=redis://127.0.0.1:6379

# Optional: raises GitHub API limits from 60/hr (unauth) to 5000/hr
GITHUB_TOKEN=

# Optional: enables the AI reasoning layer (Task 8)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: official X API bearer token. Without it X is reported as
# "unavailable via public/official access" — never scraped.
X_BEARER_TOKEN=

# Collector toggles / rate limits (all collectors individually togglable)
OSIN_COLLECTOR_GITHUB_ENABLED=true
OSIN_COLLECTOR_GITHUB_RPM=15
OSIN_COLLECTOR_USERNAME_FANOUT_ENABLED=true
OSIN_COLLECTOR_USERNAME_FANOUT_RPM=10
OSIN_COLLECTOR_OFFICIAL_SOCIAL_ENABLED=true
OSIN_COLLECTOR_OFFICIAL_SOCIAL_RPM=10
OSIN_COLLECTOR_EMAIL_ENABLED=true
OSIN_COLLECTOR_EMAIL_RPM=10
OSIN_COLLECTOR_PHONE_ENABLED=true
OSIN_COLLECTOR_PHONE_RPM=20
OSIN_COLLECTOR_NAME_SEARCH_ENABLED=true
OSIN_COLLECTOR_NAME_SEARCH_RPM=10
