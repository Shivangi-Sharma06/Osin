# Copy to .env and adjust. All values have sane local defaults in server/src/config.ts.
PORT=4000
DATABASE_URL=postgres://osin@127.0.0.1:5433/osin
REDIS_URL=redis://127.0.0.1:6379

# Optional: raises GitHub API limits from 60/hr (unauth) to 5000/hr
GITHUB_TOKEN=

# Optional: enables the AI reasoning layer (Task 8)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Collector toggles / rate limits (all collectors individually togglable)
OSIN_COLLECTOR_GITHUB_ENABLED=true
OSIN_COLLECTOR_GITHUB_RPM=15
